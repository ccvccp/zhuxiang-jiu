# zhuxiang-jiu 生产环境配置模板(P4.1 部署加固)
#
# 用法: 复制为 .env 后填入真实值; .env 已被 .gitignore 忽略, 不会提交。
# docker-compose backend 服务经 env_file 注入本文件, 并以
# environment 段的默认值为兜底(功能开关默认 off)。
#
# 安全提示: LLM_API_KEY 为敏感凭据, 严禁提交到仓库/日志/截图。

# ============================================================
# LLM 基础(智谱开放平台)
# ============================================================
# API 密钥(必填, 缺失即全部 LLM 轨关闭)
LLM_API_KEY=
# OpenAI 兼容端点(默认智谱)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 总开关(off 强制全部走 rule 轨)
LLM_ENABLED=on

# ============================================================
# 功能轨开关(默认 off; 需开启的轨设 on)
# ============================================================
# chat 链路 RAG 大模型合成(替代 rule 模板融合)
KNOWLEDGE_CHAT_LLM=off
# Embedding 语义检索(同义改写可命中; 条目需 rebuild-index 回填)
KNOWLEDGE_EMBEDDING=off
# 多模态图片/视频视觉理解(GLM-4V 自动生成描述/时间轴)
KNOWLEDGE_MEDIA_LLM=off
# 抓取内容智能清洗(去导航/广告/版权噪声)
KNOWLEDGE_CRAWL_LLM=off
# 检索结果 Rerank 重排(相关性精排)
KNOWLEDGE_RERANK=off

# ============================================================
# 模型名(按需覆盖默认)
# ============================================================
LLM_MODEL=glm-4-flash
VISION_MODEL=glm-4v-flash
EMBEDDING_MODEL=embedding-3
ASR_MODEL=glm-asr-2512
RERANK_MODEL=rerank

# ============================================================
# 超时(秒)
# ============================================================
LLM_TIMEOUT=15
LLM_VISION_TIMEOUT=60

# ============================================================
# 后台调度开关(默认 off)
# ============================================================
AI_LEARNING_AUTO=off
ORDER_TIMEOUT_AUTO=off
KNOWLEDGE_QUALITY_AUTO=off

# ============================================================
# AI智能中枢模块(35号·AI Hub)
# ============================================================
# 中枢总开关(关闭时前端入口降级纯文本直连 chat 旧轨)
HUB_ENABLED=on
# 会员日语音转写次数上限
HUB_ASR_DAILY_LIMIT=200
# 意图分类 LLM 增强轨(P1, 默认规则轨)
HUB_INTENT_LLM=off
# 能力熔断阈值(7日成功率低于该值自动摘除, P1)
HUB_CIRCUIT_MIN_SUCCESS=0.5

# ============================================================
# 验真风控(47号·P3 先验回流, 默认 off——画像只沉淀不干预)
# ============================================================
# on=画像信任度回流验真通道: v2 起点折扣 + L2/L3 入分层级乘性
RISK_PRIOR_MODE=off
