# ============================================================
# 竹香酒后端环境变量模板(外部依赖凭证)
# ------------------------------------------------------------
# 使用: 复制为 .env(或部署平台密钥管理)后按域填值;
#       所有开关默认 mock——零凭证本地/CI 全绿, 填值不影响未启用域。
# 安全: 凭证绝不提交仓库; 生产经部署平台密钥注入;
#       私钥支持内联 PEM 或挂载文件路径(pay_gateway._env_or_file)。
# 自检: python check_external_creds.py(核对就绪度, 不打印值)
# 详见: docs/外部凭证接入Runbook.md(申请入口/灰度步骤/验收/回滚)
# ============================================================

# ------------------------------------------------------------
# 通用(存储与锁, 本地开发默认内存/asyncio 无需配置)
# ------------------------------------------------------------
# STORE_MODE=redis
# LOCK_MODE=redis
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# IMTM 动态定价因子·最小闭环(2026-10-16, growth80 Escrow 三档留存乘数)
# 蓝图: R_final = R_base×f(Q_user)×f(S_demand)×f(P_risk)×M_game
# 详见 services/growth80_pricing.py 与 docs/会员流量智能模块蓝图与现有实现对照分析.md
# ------------------------------------------------------------
# GROWTH_ESCROW_MULTIPLIER=observe      # off=bit级v2-E3原行为 / observe=因子快照
#                                       #   留痕不改分值(默认) / enforce=M_game三档
#                                       #   乘数生效(gold 1.2·首单 / base 1.0·回访
#                                       #   或login≥3 / weak 0.8·login1-2转80%解冻)
#                                       #   其余因子恒1.0留痕备P3(fQUser个体pLTV/
#                                       #   fPRisk设备闸作弊分)

# ------------------------------------------------------------
# 蓝图近期项四件(2026-10-16, 详见 docs/竹香酒商城AgentAI进化蓝图与现有实现对照分析.md 第五节)
# ------------------------------------------------------------
# LIVE_QA_MODE=on                        # 数字人直播弹幕QA(④): off=禁用 /
#                                       #   on=启用(默认, 复用knowledge规则轨
#                                       #   60s同问去重+unsolved缺口登记)
# REPURCHASE_PUSH_MODE=observe           # 无感复购预测(②): off=不扫描 /
#                                       #   observe=建议书留痕绝不发送(默认) /
#                                       #   enforce=仅解锁管理员逐条确认后的
#                                       #   dispatch(仍不自动触达)。
#                                       # qFactor(周期CV≤0.3→1.2/≤0.6→1.0/
#                                       #   >0.6→0.8)为IMTM f(Q_user) hint,
#                                       #   observe only未接定价链
# REPURCHASE_SCAN_AUTO=off               # 复购扫描调度(R2): off=不启动(默认,
#                                       #   零行为) / on=随主站启动每日扫描
# REPURCHASE_SCAN_INTERVAL_MIN=1440      # 扫描间隔分钟, 下限60(默认每日)
# LIVE_QA_KB_CATEGORY=live               # 直播专属知识源(L3): live_qa 检索
#                                       #   rag_answer 时优先的 category, 该类
#                                       #   空自动回退全库; 运营经 create_entry
#                                       #   按 category=live 录入直播语料
# XIAOZHU_PERSONA_MODE=on                # 动态Persona引擎最小版: persona行
#                                       #   (等级+偏好+情绪三因子)注入 context_
#                                       #   desc 并留痕 personaLine; LLM轨默认
#                                       #   off 下 context_desc 无消费方, 规则轨
#                                       #   零行为变化; off=不注入不留痕
# XIAOZHU_JOYVOICE_VOICE_MODE=observe    # 情绪→音色路由: off=零痕迹 /
#                                       #   observe=只留痕 wouldVoice 不实切
#                                       #   (默认, 对齐 wake EMA 范式) /
#                                       #   enforce=预合成实切音色
#                                       #   (care→chuichui/steady→tongtong/
#                                       #   cheerful→luodo, 执行轮不映射)

# ------------------------------------------------------------
# agent75 小竹蓝图P3·四角色拓扑/记忆注入/多步熔断/避坑表(2026-10-16)
# ------------------------------------------------------------
# AGENT75_ROLE_KILL_MEMBER=off           # 四角色独立kill-switch: 任一角色置
# AGENT75_ROLE_KILL_MERCHANT=off        #   on 时该角色任务409, 其余角色不受
# AGENT75_ROLE_KILL_OPS=off             #   影响; 全局 AGENT75_KILL 仍优先
# AGENT75_ROLE_KILL_CS=off
# AGENT75_MEMORY_MODE=observe           # 跨会话记忆注入: off=零痕迹 /
#                                       #   observe=memoryLine只落TaskRecord
#                                       #   不进prompt(默认) / on=前缀拼入
#                                       #   generate prompt(画像取voice82三表
#                                       #   role/topGoal/意图top3标签, 无原文)
# AGENT75_WORKFLOW_MODE=off             # 多步编排(classify→generate→review
#                                       #   步链, 步间传递): off=现单步行为
#                                       #   逐字不变(默认) / on=按intent激活
# AGENT75_MAX_STEPS=5                   # 步数熔断硬上限, 超限截断转人工
#                                       #   (status=failed+interrupted_reason,
#                                       #   admin inmail告警24h幂等)
# AGENT75_PITFALL_MODE=on               # 工具避坑表: 同签名(skill_id:trace
#                                       #   状态)30min内失败≥3次→短路10min直
#                                       #   落兜底链, half-open试探恢复;
#                                       #   进程级重启清零(短时自适应);
#                                       #   off=完全不查不记

# ------------------------------------------------------------
# 小竹蓝图P4·MCP面与82号开闸(2026-10-16 晚)
# ------------------------------------------------------------
# MCP_SERVER_MODE=off                   # MCP只读工具面(与商城蓝图V4汇合):
#                                       #   off=POST /mcp 统一403(默认) /
#                                       #   on=JSON-RPC 2.0(initialize/
#                                       #   tools/list/tools/call)
# MCP_SERVER_TOKEN=                     # Token强鉴权(Header X-MCP-Token,
#                                       #   hmac比对)——不配置则拒绝所有
#                                       #   调用; 白名单=零隐私12条(product
#                                       #   族/promo/nav/help/wine族/map/
#                                       #   zs/coupon)∩registry∩沙箱三重交集
# MCP_TOOLS=                            # 可追加白名单(逗号分隔action, 仍须
#                                       #   readonly+registry校验, 敏感拒绝)
# VOICE82_ASSIST_ROLLOUT=0              # 82号assist按比例放量(%): 0=全hold(
#                                       #   默认, 即使VOICE82_MODE=assist也恒
#                                       #   注基线) / 100=全量; 运行时优先读
#                                       #   Redis键 zhuxiang:voice82:rollout
#                                       #   (POST /api/voice82/rollout 可调,
#                                       #   免重启); Knuth散列确定性分桶,
#                                       #   游客不参与; 开闸runbook: GET
#                                       #   /rollout 看门槛(shadow≥200会话且
#                                       #   正反馈≥55%)→POST 5起步→观察7日
#                                       #   →逐步放量, 回滚=POST 0

# ------------------------------------------------------------
# 小竹蓝图P4-10·DPO数据集与SelfPlay压测(2026-10-16 晚, 三批)
# 双红线: 只备数据不微调 / 偏好对必经人工评审环(approved才是数据集)
# ------------------------------------------------------------
# DPO_COLLECT_AUTO=off                  # DPO偏好对归集调度: off=不启动(
#                                       #   默认) / on=随主站定时归集
# DPO_COLLECT_INTERVAL_MIN=1440         # 归集间隔分钟, 下限60(默认每日)
#                                       #   五源: S1 rag dual双评审×判别
#                                       #   否决 / S2 👎轮×同intent👍轮±7天
#                                       / S3 转人工前自动答×人工坐席回复
#                                       / S4 失败挖掘×高分轮 / S5 SelfPlay
#                                       #   缺口→知识发布答案×unsolved兜底
#                                       #   质量闸+PII复检+幂等, 只产pending
# SELFPLAY_MODE=off                     # SelfPlay红蓝对抗调度: off=不启动(
#                                       #   默认) / on=定时批量压测
# SELFPLAY_INTERVAL_MIN=720             # 压测间隔分钟(默认12小时)
# SELFPLAY_BATCH=20                     # 每轮抽样上限(成本闸)
#                                       #   六类攻击×现有防线, 判定器纯规则;
#                                       #   失守: 安全告警(signal selfplay)
#                                       #   /A6缺口入knowledge队列/ metrics
# SELFPLAY_LLM=off                      # LLM攻击生成器: off=纯模板(默认) /
#                                       #   on=每轮追加≤5条LLM生成攻击文本
#                                       #   (判定仍走确定性检查器, LLM不产
#                                       #   判定; 失败fail-soft回落模板)
# ①满减最优测算 coupon.best_combo 为小竹只读指令(常量取自order_service
#   单一数据源, 无环境变量); ③站内内容社区 community 为只读feed+先审后显
#   UGC, 无环境变量

# ============================================================
# 一、支付渠道(payment, 复用 PAY60_CHANNEL_MODE 三态)
# 灰度顺序: mock(默认) → mock_fallback → real
# ============================================================
# PAY60_CHANNEL_MODE=mock
# --- 渠道主凭证(real 总开关校验项) ---
# PAY60_CHANNEL_KEY=
# PAY60_NOTIFY_URL=https://zyjiu.com/api/payment/callback/pay
# --- 微信支付 V3(商户平台 pay.weixin.qq.com) ---
# PAY60_WECHAT_MCHID=
# PAY60_WECHAT_APPID=
# PAY60_WECHAT_SERIAL_NO=
# PAY60_WECHAT_PRIVATE_KEY=            # 商户API证书私钥(PEM 内联或路径)
# --- 支付宝开放平台 + 花呗分期(open.alipay.com; 花呗借道支付宝无需单独商户号) ---
# PAY60_ALIPAY_APPID=
# PAY60_ALIPAY_PRIVATE_KEY=            # 应用私钥(PEM 内联或路径)
# PAY60_ALIPAY_RETURN_URL=             # page.pay 同步回跳地址(如
#                                      # https://域名/api/payment/return;
#                                      # 空=不下发 return_url 参数)
# --- 京东白条(京东金融商户资质 + Baitiao 支付产品; 未签约保持注释即无影响) ---
# PAY60_BAITIAO_MERCHANT=
# PAY60_BAITIAO_KEY=

# ============================================================
# 二、高德地图 LBS(location, LOC_AMAP_MODE 三态)
# Key 类型必须为「Web 服务」(lbs.amap.com); 建议企业认证+IP 白名单
# ============================================================
# LOC_AMAP_MODE=mock
# AMAP_KEY=
# AMAP_SECRET=                          # 可选(数字签名, 代替明文 key)

# ============================================================
# 三、物流商开放平台(logistics, LGS_CARRIER_MODE 三态)
# 聚合平台(快递鸟/快递100 商家版); 电子面单 real 出单即计费, 仅生产开
# ============================================================
# LGS_CARRIER_MODE=mock
# LGS_KDN_EBUSINESS_ID=
# LGS_KDN_APP_KEY=
# LGS_CALLBACK_TOKEN=                   # 回调验签密钥(real/mock_fallback 强制, 聚合平台侧同值配置)

# ============================================================
# 四、NFC 防伪(trace, TRACE_ANTI_MODE 三态)
# NFC 芯片厂商发码 API(生产侧绑定环节; 消费侧碰一碰无外部调用)
# ============================================================
# TRACE_ANTI_MODE=mock
# TRACE_NFC_VENDOR_URL=
# TRACE_NFC_API_KEY=

# ============================================================
# 五、区块链存证(location, CHAIN_EVIDENCE_MODE 三态)
# 联盟链开放服务(BSN/蚁链/至信链, HTTP API 按条计费; 不自建节点)
# ============================================================
# CHAIN_EVIDENCE_MODE=mock
# CHAIN_NODE_URL=
# CHAIN_AK=
# CHAIN_SECRET=
# CHAIN_CONTRACT=                       # 可选(存证合约地址, 缺省 evidence)

# ============================================================
# 六、短剧智能研判引擎数据源(85号 drama85, DRAMA85_SOURCE_MODE 三态)
# 真实数据源走标准 JSON 契约(两类合规供给方任选):
#   A. 企业开通的第三方短剧数据服务 API(商务采购)
#   B. 自建合规采集 worker(只采公开元数据)输出契约
# 契约详见 services/drama85_source_gateway.py 模块注释
# ============================================================
# DRAMA85_SOURCE_MODE=mock              # mock/mock_fallback/real
# DRAMA85_SOURCE_URL=                   # 契约端点(GET ?offset=&n=)
# DRAMA85_SOURCE_API_KEY=
# DRAMA85_SOURCE_SECRET=                # 可选(HMAC 签名, 与供给方同值)
# DRAMA85_SOURCE_QPS=1                  # 可选(频控, 默认 1)
# --- 第三方 API 字段映射(响应非契约格式时配置; auto: 契约直用优先) ---
# 未选型时按主流第三方风格预置三份模板, 拿到真实样例响应后对号入座并微调字段名:
#   键=list(剧集数组点路径, 必需) + 契约字段→第三方字段(字段名或点路径, 如 metrics.plays)
#   契约字段: title(必需)/platforms/episodes/durationSec/tags/plays/likes/comments/shares/
#            completionRate(0-1小数)/commentsData(评论三形态兼容)/subtitleText(四段标注)/structure(直传)
#
# 模板A 嵌套data.rows+驼峰(电商数据服务常见): {"data":{"rows":[{dramaName,platform,episodeCount,duration,playCnt,likeCnt,commentCnt,shareCnt,finishRate,hotComments,synopsis}]}}
# DRAMA85_SOURCE_FIELD_MAP={"list":"$.data.rows","title":"dramaName","platforms":"platform","episodes":"episodeCount","durationSec":"duration","plays":"playCnt","likes":"likeCnt","comments":"commentCnt","shares":"shareCnt","completionRate":"finishRate","commentsData":"hotComments","subtitleText":"synopsis"}
#
# 模板B 嵌套data.list+下划线(国内开放平台/Python系常见): {"data":{"list":[{drama_name,platform,total_episodes,duration_seconds,play_count,like_count,comment_count,share_count,completion_rate,hot_comments,subtitle}]}}
# DRAMA85_SOURCE_FIELD_MAP={"list":"$.data.list","title":"drama_name","platforms":"platform","episodes":"total_episodes","durationSec":"duration_seconds","plays":"play_count","likes":"like_count","comments":"comment_count","shares":"share_count","completionRate":"completion_rate","commentsData":"hot_comments","subtitleText":"subtitle"}
#
# 模板C 顶层数组+短别名(轻量聚合接口常见): {"list":[{name,platform,ep,total_sec,pv,like_num,cmt_num,share_num,finish_rate,top_comments,synopsis}],"hasMore":false}
# DRAMA85_SOURCE_FIELD_MAP={"list":"$.list","title":"name","platforms":"platform","episodes":"ep","durationSec":"total_sec","plays":"pv","likes":"like_num","comments":"cmt_num","shares":"share_num","completionRate":"finish_rate","commentsData":"top_comments","subtitleText":"synopsis"}

# --- 悟空浏览器短剧合规采集 worker(通道②, 独立进程, 见 drama85_wukong_worker.py) ---
# 三形态: json(接口页)/html(榜单页)/share(分享链接→单剧元数据, 实测已打通)
# 用法: probe --gen-map 自动生成映射并试采 → 粘贴下方 FIELD_MAP → fetch/serve
# 85号侧消费: DRAMA85_SOURCE_URL=http://127.0.0.1:8510/dramas + DRAMA85_SOURCE_API_KEY=local-worker
# WUKONG_LIST_URL=                     # json/html 形态目标页 URL
# WUKONG_LIST_KIND=auto                # json/html/share/auto(配了 SHARE_URLS 未配 LIST_URL → share)
# WUKONG_SHARE_URLS=                   # share 形态: 分享链接列表(逗号/分号/空白分隔)
#                                      # 单剧元数据(title/集数/完结状态), 指标留通道①; 逐链 robots/限速/T+1 缓存
#
# ★ 分享链实测可用配置(2026-10-13, 悟空 App 分享→复制链接→追加到列表; 解析器内置无需 FIELD_MAP/XPATH;
#   三级解析: ①RENDER_DATA SSR 优先(seoTDK 剧名/tomatoPlayetInfo.serialCount 总集数/videoDuration
#     单集时长/articleInfo.content 剧情简介→subtitleText 激活研判层结构化/seriesId 去重; 当前集指标
#     videoPlayCount·diggCount 仅探针预览不入契约——集级口径与红果全剧级不可比, 防污染爆款指数;
#     relatedInfo 恒 null 无推荐位, 运行时签名 API 拉取不可采);
#   ②正文正则回退(<title>/og:title+「第N集 共X集 已完结」+og:url itemId, 引导页丢弃);
#   ③西瓜短剧页(v.douyin 短链 302 → iesdouyin /xg/video/): 剧名/出品方/#话题/发布日期/itemId,
#     episodes=0 如实(无总集数), 主体指标运行时不采, platforms=xigua;
#   ④红果漫剧分享链(hainanyuyue.com/s/ 域): JSON 剧名+第N集(当前集下界)+题材标签+vid 去重):
