# HONGGUO_QPS=1
# HONGGUO_CACHE_TTL=86400
# HONGGUO_PLATFORMS=hongguo
# HONGGUO_INCLUDE_RECOMMEND=1
# HONGGUO_PORT=8511
#   实测: 牢狱蒙尘第一季 主剧 ep=100 plays=1991万 likes=1.2万 tags=[战神,都市,豪门]
#         + 12 推荐位(脑洞/玄幻/剧情/末世/恋爱, plays 128万~6936万) 全指标入契约
#   验证: python drama85_hongguo_worker.py probe | fetch --n 15
#   85号接入: DRAMA85_SOURCE_URL=http://127.0.0.1:8511/dramas (与悟空 8510 并行)
# 映射配置(json/html 形态用; probe --gen-map 自动生成草稿后微调; 以下为字节系风格预置):
#   风格A data.list+驼峰(字节系 H5/接口常见)
# WUKONG_FIELD_MAP={"list":"$.data.list","title":"dramaName","tags":"tag","episodes":"episodeCount","durationSec":"duration","plays":"playCnt","likes":"likeCnt","comments":"commentCnt","shares":"shareCnt","completionRate":"finishRate","subtitleText":"synopsis"}
#   风格B data.items+下划线(开放平台风格)
# WUKONG_FIELD_MAP={"list":"$.data.items","title":"drama_name","tags":"category","episodes":"total_episodes","durationSec":"duration_seconds","plays":"play_count","likes":"like_count","comments":"comment_count","shares":"share_count","completionRate":"completion_rate","subtitleText":"description"}
# WUKONG_XPATH={"item":"//div[@class='item']","title":".//h3/text()"}  # HTML 形态通用骨架(item 绝对+字段相对)
#
# ★ 列表页实测可用配置(2026-10-13, 短剧工程榜单——数据源为抖音官方短剧日榜 TOP10,
#   robots 允许, SSR HTML; plays=热度值口径; 悟空 web 无公开列表页, 以此站代之):
# WUKONG_LIST_URL=https://www.duanjugongcheng.com/cn/bangdan
# WUKONG_LIST_KIND=html
# WUKONG_PLATFORMS=douyin
# WUKONG_XPATH={"item":"//li[.//a[contains(@href,'/bangdan/ju/')]]","title":".//a[contains(@href,'/bangdan/ju/')]/text()","tags":".//a[contains(@href,'/bangdan/genre/')]/text()","plays":".//span[contains(@class,'tabular-nums') and contains(@class,'text-slate-900')]/text()"}
#
# ★ 出海新剧列表实测可用配置(2026-10-13, shortdramawiki——13 平台 3.2 万剧库每日重扫,
#   robots 允许普通页; 条目含平台名/集数; 同机多数据源=多 worker 实例各配一套 env):
# WUKONG_LIST_URL=https://shortdramawiki.com/en/new/
# WUKONG_LIST_KIND=html
# WUKONG_XPATH={"item":"//a[contains(@class,'poster-card')]","title":".//div[@class='title']/text()","episodes":".//span[@class='badge']/text()","platforms":".//div[@class='meta']/text()"}
# WUKONG_PLATFORMS=wukong,douyin,hongguo  # 契约 platforms 默认(字节系并集)
# WUKONG_QPS=1                         # 限速(0.2~5; 红线不可关)
# WUKONG_CACHE_TTL=86400               # T+1 缓存秒(最小 60)
# WUKONG_PORT=8510                     # serve 模式端口

# ── Day1 持久化层(2026-10-15, docs/短剧榜单采集持久化落地方案.md)────────────
# MySQL 连接串(本地容器 drama85-mysql, 库 drama85; 真实值落 .env 已 gitignore)
# DRAMA85_DB_URL=mysql+pymysql://root:<密码>@127.0.0.1:3306/drama85?charset=utf8mb4
# 建库建表: python db.py            (幂等, 执行 drama85_schema.sql)
# 种子任务: python seed_jobs.py      (crawl_job ≥5 条)
# 落库层:   python drama85_persist_worker.py --once   (Day2 交付)

# ── Day3 新榜周榜文章页(2026-10-15)───────────────────────────────────────────
# 红线: 只采 newrank.cn/article/detail/* 文章页(SSR); nr_ 数据详情页终局不可采不碰
# 当期:   python drama85_xinbang_crawler.py --url <文章URL> --once --verify
# 结构:   正文详评(名次/播放/账号,精确) + TOP20 榜单竖图(词级几何 OCR, 剧名候选)
# 实测期: https://www.newrank.cn/article/detail/34766 (统计周期 2026-09-13~09-19)
# 注意:   统计周期句式「…至9月19日」结束日省略年份; 榜单 tag 列表页为 JS 渲染(不采)

# ── Day4 媒体图文榜(2026-10-15)───────────────────────────────────────────────
# 双源均为澎湃 m.thepaper.cn 公开转载图文(SSR 纯文本可解析, robots 放行 newsDetail)
# dataeye : DataEye 月榜一文三榜 → rank_type monthly / monthly_douyin / monthly_hongguo
#           实测期 https://m.thepaper.cn/newsDetail_forward_34234356 (2026年9月榜)
# kuaishou: 快手星芒片单 → rank_type=new(无名次无周期, 全量《》收快照留上下文)
#           实测期 https://m.thepaper.cn/newsDetail_forward_32534610 (春节内容矩阵)
# 用法:    python drama85_media_crawler.py --source {dataeye|kuaishou} --url <URL> --once --verify
# 解析纪律: 名次/数值只从同子句取(剧名后至句读+前置12字), 命名捕获组(规避中文字面量损坏)

# ── Day5 清洗与跨源合并(2026-10-15)────────────────────────────────────────────
# 用法: python drama85_matcher.py --report   (只报告)
#       python drama85_matcher.py --run      (L1 精确补链 + L2 跨源建行互链; L3 永远只报告)
# L2 实证: 莞东风云/步步登阶 同现身 xinbang+dataeye → 建 multi 行互链 4 快照
