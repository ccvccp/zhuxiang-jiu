          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/forecast-simulate": {
      "post": {
        "tags": ["决策层"],
        "summary": "预测推演",
        "description": "季节性+趋势+容量预测+蒙特卡洛模拟。预测准确率90%。\n\n**角色**: member+\n**层级**: 决策层",
        "operationId": "forecastSimulate",
        "security": [{ "BearerAuth": [], "RoleHeader": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForecastSimulateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "推演成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForecastSimulateResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/governance": {
      "post": {
        "tags": ["决策层"],
        "summary": "治理决策",
        "description": "模型提动作+规则定执行+权限校验+区块链追溯。治理合规率100%。\n\n**角色**: admin\n**层级**: 决策层",
        "operationId": "governance",
        "security": [{ "BearerAuth": [], "RoleHeader": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GovernanceRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "治理决策完成",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GovernanceResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": {
            "description": "规则校验未通过(模型提议被规则拒绝)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "success": false,
                  "error": "DECISION_006: 规则校验未通过",
                  "errorCode": "DECISION_006"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/risk-control": {
      "post": {
        "tags": ["决策层"],
        "summary": "风控决策",
        "description": "异常检测+合规校验+风险预警+自动熔断。风控覆盖率96%。\n\n**角色**: admin\n**层级**: 决策层",
        "operationId": "riskControl",
        "security": [{ "BearerAuth": [], "RoleHeader": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RiskControlRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "风控检查完成",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RiskControlResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": {
            "description": "风控拦截(高风险交易被熔断)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "success": false,
                  "error": "DECISION_007: 风控拦截-高风险交易被熔断",
                  "errorCode": "DECISION_007"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/orchestrate": {
      "post": {
        "tags": ["编排层"],
        "summary": "编排调度",
        "description": "28模块跨域工作流编排+任务分解+依赖管理。编排成功率95%。\n\n**角色**: agent+\n**层级**: 编排层\n**并发安全**: Mutex锁 `decision:orchestrate:{workflowId}`",
        "operationId": "orchestrate",
        "security": [{ "BearerAuth": [], "RoleHeader": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrchestrateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "编排成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrchestrateResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/capability-route": {
      "post": {
        "tags": ["编排层"],
        "summary": "能力路由",
        "description": "原子能力插件池(120个)+动态组合(≥20种)+按需调度。能力复用率78%。\n\n**角色**: store_owner+\n**层级**: 编排层",
        "operationId": "capabilityRoute",
        "security": [{ "BearerAuth": [], "RoleHeader": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CapabilityRouteRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "路由成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CapabilityRouteResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": {
            "description": "预算不足(延迟/成本超出budget)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "success": false,
                  "error": "DECISION_008: 预算不足",
                  "errorCode": "DECISION_008"
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/role-copilot": {
      "post": {
        "tags": ["执行层"],
        "summary": "角色决策助理",
        "description": "为5类角色(会员/代理商/访客/网店主/管理员)提供Copilot式决策支持。决策准确率92%。先Copilot后Agent。\n\n**角色**: 全角色(按角色身份返回不同建议)\n**层级**: 执行层",
        "operationId": "roleCopilot",
        "security": [{ "BearerAuth": [], "RoleHeader": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RoleCopilotRequest" }
            }
          }
        },
        "responses": {
