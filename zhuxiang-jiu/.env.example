# ============================================================================
# 竹香网(zxjiu.com) 生产环境变量模板
# ============================================================================
# 生产位置: /opt/zhuxiang/.env (docker-compose env_file 加载)
# 说明:
#   - 本模板对齐生产现状(2026-09-19 快照); 敏感值已替换为 <在此填入>
#   - STORE_MODE=redis / LOCK_MODE=redis / REDIS_URL / TZ / PORT 在
#     docker-compose.yml 的 environment 段硬编码(覆盖 .env 同名项),
#     如需修改改 compose 文件
#   - 修改后生效: cd /opt/zhuxiang && docker compose up -d backend
# ============================================================================

# ----------------------------------------------------------------------------
# 【待注入凭据区】(以下两项尚未配置——配置后零代码改动自动激活)
# ----------------------------------------------------------------------------

# 高德天气 Key(时空情景感知 P0 天气通道)
# 申请: 高德开放平台 → 应用管理 → 创建应用 → 添加 Key →
#       服务平台务必选「Web 服务」(选 JS API 会报 INVALID_USER_SCHEME)
# 未配置时 /api/scene/weather 优雅降级(available=false)
GAODE_WEATHER_KEY=<在此填入>

# 阿里云短信(保证金到期通知 + 登录验证码双通道)
# 申请: 阿里云短信服务 → 签名管理(企业资质) + 模板管理(通知短信)
# 基础四件套(验证码通道) + 保证金通知模板码:
SMS_ALIYUN_ACCESS_KEY_ID=<在此填入>
SMS_ALIYUN_ACCESS_KEY_SECRET=<在此填入>
SMS_ALIYUN_SIGN_NAME=<签名名称, 如: 竹香网>
# 验证码模板(单变量 ${code}):
SMS_ALIYUN_TEMPLATE_CODE=<SMS_xxxxxxxx>
# 保证金到期通知模板(五变量 name/date/days/rate/refund, 文案见
# backend/services/sms_aliyun.py 模块头注释——控制台申请后填码):
SMS_ALIYUN_MARGIN_TEMPLATE_CODE=<SMS_yyyyyyyy>
# 未配置时验证码/通知均走日志模拟留痕(配置后自动切真实通道)

# ----------------------------------------------------------------------------
# 认证模式(生产: strict 仅 Bearer; 回滚改 compat)
# ----------------------------------------------------------------------------
AUTH_MODE=strict

# ----------------------------------------------------------------------------
# LLM 总控(智谱 GLM)
# ----------------------------------------------------------------------------
LLM_API_KEY=<在此填入>
# LLM_MODEL=glm-4-flash        # compose 段默认, 需改在 compose 覆盖

# ----------------------------------------------------------------------------
# 大模型灰度档位(生产现状: 73/74/75/76/77 为 full, 其余 assist)
# 四档: off / shadow / assist / full (回滚: 改 off 后 up -d backend)
# ----------------------------------------------------------------------------
MEMBER73_MODE=full             # 会员体验
NEXUSFLOW74_MODE=full          # 会员旅程编排
ZYH_MODE=full                  # 75 竹韵·智衡(竹奕酒)
SYNAPSE_MODE=full              # 76 织智 Synapse-Weave
ZJIAN_MODE=full                # 77 竹鉴 BambooVerify
PAY71_MODE=assist              # 支付
PAY71_IMMUNITY=1
XINZHI_MODE=assist             # 信值
CHAT_LLM_MODE=assist           # 对话
DUAL_MODE=assist               # 双模
ATTRACT72_MODE=assist          # 引流
KB57_MODE=assist               # 知识库
KB57_LEARN_MODE=on             # 知识库学习层
ALLIANCE37_MODE=assist         # 联盟
TRUST45_MODE=assist            # 信值 UEBA
ZW_MODE=assist                 # 智运物流
AV62_MODE=assist               # 无形资产估值
XX65_MODE=assist               # 网店及商品管理
XIAOZHU_MODE=assist            # 智能语音
WALLET_MODE=assist             # 钱包盈利
CREDIT_MODE=assist             # 信用管理
ZT_MODE=assist                 # 智图地图
PDM_MODE=assist                # 智能产品管理
AGREEMENT_MODE=assist          # 条款协议
SITE_THEME_MODE=assist         # 图标主题
HELP_MODE=assist               # 智能叫帮
LOGIN53_MODE=on                # 登录中枢

# ----------------------------------------------------------------------------
# 调度器开关(生产现状: 以下均 on)
# ----------------------------------------------------------------------------
PROMO_RADAR_AUTO=on           # 热点雷达
PROMO_PUBLISH_AUTO=on         # 内容发布
BLOGGER_RADAR_AUTO=on
BLOGGER_PUBLISH_AUTO=on
BLOGGER_LEARNING_AUTO=on
KNOWLEDGE_QUALITY_AUTO=on     # 知识质量巡检
ALLIANCE37_GUARD_AUTO=on
ALLIANCE_SETTLE_AUTO=on

# ----------------------------------------------------------------------------
# 热点雷达源(36号; 生产 URL 未配置——KEY 已备)
# ----------------------------------------------------------------------------
HOTSPOT_BAIDU_URL=
HOTSPOT_DOUYIN_URL=
HOTSPOT_WEIBO_URL=
HOTSPOT_ZHIHU_URL=
HOTSPOT_XIAOHONGSHU_URL=
HOTSPOT_BAIDU_API_KEY=<在此填入>
HOTSPOT_DOUYIN_API_KEY=<在此填入>
HOTSPOT_WEIBO_API_KEY=<在此填入>
HOTSPOT_ZHIHU_API_KEY=<在此填入>
HOTSPOT_XIAOHONGSHU_API_KEY=<在此填入>

# ----------------------------------------------------------------------------
# 渠道推送(36号; mock 模式留痕)
# ----------------------------------------------------------------------------
PROMO_CHANNEL_MODE=mock
PROMO_CHANNEL_DOUYIN_KEY=<在此填入>
PROMO_CHANNEL_XIAOHONGSHU_KEY=<在此填入>
PROMO_CHANNEL_WEIBO_KEY=<在此填入>
PROMO_CHANNEL_WECHAT_MOMENTS_KEY=<在此填入>
PROMO_CHANNEL_WECHAT_CHANNELS_KEY=<在此填入>
PAY60_CHANNEL_MODE=mock_fallback

# ----------------------------------------------------------------------------
# 基础站点
# ----------------------------------------------------------------------------
SITE_BASE_URL=https://zxjiu.com
BAIDU_PUSH_SITE=zxjiu.com
BAIDU_PUSH_TOKEN=<在此填入>
