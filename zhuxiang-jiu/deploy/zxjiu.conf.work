# ============================================================
# zxjiu.com 站点配置 · nginx
# ============================================================
# 首页 UA 分流(2026-10-02): PC 裸根访问 → 官网 PC 首页(official.html
# ——品牌故事/同盟臻选所在); 移动端保持 Taro 商城 SPA; 带 query 参数的
# 根访问(72号引流落地 /?clickId&v72#/pages/...)一律走 SPA 保归因链。
map $http_user_agent $zxjiu_is_mobile {
    default 0;
    "~*(android|iphone|ipod|ipad|mobile|harmony|phone)" 1;
}
map "$zxjiu_is_mobile$args" $zxjiu_home {
    default /index.html;          # 移动端或带参数(引流落地) → 商城 SPA
    "0" /official.html;           # PC + 无参数裸根 → 官网首页
}

# 架构: 同源部署——H5 静态产物(taro build:h5 → dist/) + /api 反代后端容器
#       (浏览器与 API 同源, 无跨域; 后端 CORS 白名单已含本域名)
#
# 部署步骤(服务器上执行):
#   1. DNS 解析: 域名商处添加 A 记录 zxjiu.com / www.zxjiu.com → 服务器公网 IP
#   2. 上传产物: taro-app/dist/ → /var/www/zxjiu/dist/
#   3. 安装配置: 本文件 → /etc/nginx/sites-available/zxjiu.conf
#                ln -s /etc/nginx/sites-available/zxjiu.conf /etc/nginx/sites-enabled/
#                nginx -t && systemctl reload nginx
#   4. HTTPS 证书: certbot --nginx -d zxjiu.com -d www.zxjiu.com
#      (自动改写本配置追加 443 server 块与 http→https 跳转)
#
# 注意: 前端 API_BASE 已做域名感知——H5 从 zxjiu.com 打开时自动请求
#       https://zxjiu.com/api/*(本反代), 从局域网 IP 打开时回退调试后端
server {
    server_name zxjiu.com www.zxjiu.com;

    # H5 静态产物根目录
    root /var/www/zxjiu/dist;
    index index.html;

    # gzip 压缩(JS 产物 ~1.2MB 压后约 1/3)
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # 带哈希指纹的静态资源长缓存(文件名含 contenthash, 内容变更即换名)
    location ^~ /js/  { expires 30d; add_header Cache-Control "public, immutable"; }
    location ^~ /css/ { expires 30d; add_header Cache-Control "public, immutable"; }

    # 入口页不缓存: index.html 引用哈希清单, 重部署后旧清单会指向已被
    # 删除的旧哈希文件(白屏直到手动刷新), 必须每次回源取最新
    location = /index.html { add_header Cache-Control "no-cache, no-store, must-revalidate"; add_header Pragma "no-cache"; add_header Expires "0"; }

    # API 反代到本机后端容器(docker-compose 映射 127.0.0.1 可达的 8000 端口)
        # SEO: sitemap/robots 反代后端(attract 域名级端点, 精确匹配优先于静态回退)
    location = /sitemap.xml {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }
    location = /robots.txt {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_read_timeout 30s;
    }

    # 小竹流式语音识别 WS 代理(P1: 长连接 Upgrade——须置于
    # 通用 /api/ 之前, 前缀更长优先匹配)
    # 39号 QR WebSocket(2026-09-29 §2.2 P2 预留落地: 扫码状态推送)
    # 范式=api/xiaozhu/ws(Upgrade 双头+http1.1); read_timeout 200s>
    # QR TTL 180s; 前缀覆盖 qr/* 普通请求无影响(配置等价+空Upgrade无害)
    location ^~ /api/entry/qr/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 200s;
    }

    location ^~ /api/xiaozhu/ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

location ^~ /api/ {
        client_max_body_size 10m;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # 推广短链反代后端(attract /r/{code} 302 跳转+匿名点击落库; 前缀匹配优先于 SPA 回退)
    location ^~ /r/ {
        # 72号引流: 短链爬虫封禁(2026-09-29——PetalBot 无视 robots.txt
        # 持续刷量污染归因统计; UA 精确匹配三类爬虫, 正常浏览器不受影响)
        if ($http_user_agent ~* "(PetalBot|Scrapy|SERanking)") {
            return 403;
        }

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # 根级静态 HTML(活动中心/详情页/语音页/zyh 等入口): no-cache 每次回源
    # 验证(ETag 304 秒回, 部署即生效)——曾无 Cache-Control 走启发式缓存,
    # 手机用户拿不到更新(详情页返回按钮上线后仍见旧版即此因)
    location ~ \.html$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # 根路径 UA 分流(2026-10-02, 见文件头 map): 精确匹配先于 location /
    # 的目录回退(否则 $uri/ 命中根目录必走 index 模块, 分流失效);
    # try_files 命中文件后在当前 location 处理, 故此处自带 no-cache
    location = / {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        try_files $zxjiu_home =404;
    }

    # SPA 前端路由回退(Taro H5 前端路由, 刷新非根路径不 404)
    location / {
        try_files $uri $uri/ /index.html;
    }

    listen 443 ssl; # managed by Certbot
    http2 on; # 78号P2 CDN快验: HTTP/2 多路复用(20%丢包跨境链路省冷连接握手)
    ssl_certificate /etc/letsencrypt/live/zxjiu.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/zxjiu.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}

server {
    # 百度验证文件豁免: 301 之前直接 200(百度文件验证要求不可跳转)
    set $do_redirect "";
    if ($host = www.zxjiu.com) {
        set $do_redirect "1";
    } # managed by Certbot
    if ($host = zxjiu.com) {
        set $do_redirect "1";
    } # managed by Certbot
    if ($request_uri = /baidu_verify_codeva-jMpoTDGvF4.html) {
        set $do_redirect "";
    }
    if ($do_redirect = "1") {
        return 301 https://$host$request_uri;
    }

    location = /baidu_verify_codeva-jMpoTDGvF4.html {
        default_type text/html;
        return 200 "e1759b07fcbac9b8bd9a0ec6544e885f";
    }

    location / {
        return 404; # managed by Certbot
    }

    listen 80;
    server_name zxjiu.com www.zxjiu.com;
}

