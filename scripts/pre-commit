#!/bin/sh
# ============================================================
# pre-commit · Git 提交前 CI 检查脚本 (bash 版, 跨平台)
# ------------------------------------------------------------
# 用法: 安装 git 后运行 ./scripts/install-hooks.ps1 自动配置
#   或手动复制到 .git/hooks/pre-commit 并 chmod +x
# 跳过: git commit --no-verify
# 日志: .git/hooks/pre-commit.log (追加模式, 供审计)
# ============================================================
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "$(dirname "$(dirname "$0")")")"
LOG_FILE="$REPO_ROOT/.git/hooks/pre-commit.log"

# ---------- 日志函数 ----------
# 输出到控制台 + 追加到日志文件
log() {
    msg="$1"
    echo "$msg"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $msg" >> "$LOG_FILE" 2>/dev/null || true
}

# 仅写日志文件(不输出到控制台)
log_only() {
    msg="$1"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $msg" >> "$LOG_FILE" 2>/dev/null || true
}

log "============================================================"
log "🚀 [pre-commit] CI 检查启动"
log "   仓库: $REPO_ROOT"
log "   分支: $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')"
log "   时间: $(date '+%Y-%m-%d %H:%M:%S')"
log "============================================================"

# ---------- 1. 获取暂存的 JS 文件 ----------
STAGED_FILES=$(git diff --cached --name-only --diff-filter ACM 2>/dev/null | grep '\.js$' | grep 'zhuxiang-jiu/js' || true)

FILE_COUNT=$(echo "$STAGED_FILES" | grep -c '.' 2>/dev/null || echo 0)

if [ -z "$STAGED_FILES" ]; then
    log "📋 暂存文件扫描: 0 个 zhuxiang-jiu/js/*.js 文件"
    log "✅ 无 zhuxiang-jiu JS 变更, 跳过 CI"
    log "------------------------------------------------------------"
    log "📊 决策: SKIP (无 JS 变更) | 文件数: 0 | 检查数: 0 | 错误数: 0"
    log "============================================================"
    exit 0
fi

log "📋 暂存文件扫描: $FILE_COUNT 个 zhuxiang-jiu/js/*.js 文件"
log "🚀 检测到 JS 文件变更:"
echo "$STAGED_FILES" | while read -r line; do
    log "   - $line"
done

# ---------- 2. 静态检查 (awk 单次遍历, 字符串/注释感知) ----------
log ""
log "🔍 开始静态检查 (括号()/花括号{}/方括号[], 跳过字符串和注释)..."
ERRORS=0
CHECKS_TOTAL=0
CHECKS_PASS=0
CHECKS_FAIL=0

# awk 单次遍历: 状态机跳过字符串/注释/正则字面量, 计数 3 类括号
# -v sq="'": 传入单引号字符, 避免 awk 脚本内引号转义问题
# 增强版: 识别正则字面量 /\(/ /\{n\}/ 等, 避免假阳性
# v2 修复(2026-08-29, 教训见更新日志):
#   1. 模板字符串支持 ${} 插值与嵌套反引号(in_tpl/interp/tpl_stack 栈),
#      修复"内层模板反引号被误判为外层结束→状态错乱→HTML闭合标签</a>的/
#      被误判为正则字面量"的级联误报(js/main.js 曾报 400 vs 399 假阳性)
#   2. in_re/in_class 行尾强制复位(JS 正则字面量不能跨行),
#      防止误入正则态后吞掉后续行的真实括号
run_bracket_check() {
    awk -v sq="'" '
    BEGIN { in_str=0; in_block=0; in_re=0; in_class=0; str_ch=""; prev=""; po=pc=bo=bc=so=sc=0; in_tpl=0; interp=0; tpl_stack="" }
    {
        line = $0
        i = 1
        n = length(line)
        while (i <= n) {
            c = substr(line, i, 1)
            nc = (i < n) ? substr(line, i+1, 1) : ""
            if (in_block) {
                if (c == "*" && nc == "/") { in_block=0; i+=2; continue }
                i++; continue
            }
            if (in_re) {
                if (in_class) {
                    if (c == "\\") { i+=2; continue }
                    if (c == "]") { in_class=0 }
                    i++; continue
                }
                if (c == "\\") { i+=2; continue }
                if (c == "[") { in_class=1; i++; continue }
                if (c == "]") { i++; continue }
                if (c == "/") { in_re=0; prev="/"; i++; continue }
                i++; continue
            }
            if (in_str) {
                if (c == "\\") { i+=2; continue }
                if (c == str_ch) { in_str=0; prev=str_ch }
                i++; continue
            }
            if (in_tpl) {
                if (c == "\\") { i+=2; continue }
                if (c == "`") {
                    in_tpl=0
                    if (tpl_stack != "") {
                        interp = substr(tpl_stack, length(tpl_stack), 1) + 0
                        tpl_stack = substr(tpl_stack, 1, length(tpl_stack)-1)
                    }
                    prev="`"; i++; continue
                }
                if (c == "$" && nc == "{") {
                    bo++
                    interp=1
                    in_tpl=0
                    prev="{"; i+=2; continue
                }
                i++; continue
            }
            if (c == "/" && nc == "/") { break }
            if (c == "/" && nc == "*") { in_block=1; i+=2; continue }
            if (c == "/") {
                is_re = (prev == "=" || prev == "(" || prev == "," || prev == "!" || prev == "&" || prev == "|" || prev == "^" || prev == "~" || prev == "?" || prev == ":" || prev == "+" || prev == "-" || prev == "*" || prev == "%" || prev == "<" || prev == ">" || prev == ";" || prev == "{" || prev == "[" || prev == "\"" || prev == "")
                if (is_re) { in_re=1; prev="/"; i++; continue }
                prev="/"; i++; continue
            }
            if (c == sq || c == "\"") { in_str=1; str_ch=c; i++; continue }
            if (c == "`") {
                if (interp > 0) { tpl_stack = tpl_stack interp }
                in_tpl=1
                prev="`"; i++; continue
            }
            if (c == "(") { po++; prev=c }
            else if (c == ")") { pc++; prev=c }
            else if (c == "{") {
                bo++
                if (interp > 0) { interp++ }
                prev=c
            }
            else if (c == "}") {
                bc++
                if (interp > 0) {
                    interp--
                    if (interp == 0) { in_tpl=1 }
                }
                prev=c
            }
            else if (c == "[") { so++; prev=c }
            else if (c == "]") { sc++; prev=c }
            else if (c == " " || c == "\t" || c == "\r" || c == "\n") { }
            else { prev=c }
            i++
        }
        if (in_str) in_str=0
        if (in_re) { in_re=0; in_class=0 }
    }
    END { printf "%d %d %d %d %d %d\n", po, pc, bo, bc, so, sc }
    ' "$1" 2>/dev/null
}

for f in $STAGED_FILES; do
    FULL_PATH="$REPO_ROOT/$f"
    if [ ! -f "$FULL_PATH" ]; then
        log "   ⚠️  文件不存在, 跳过: $f"
        log_only "   SKIP: $f (file not found)"
        continue
    fi

    LINE_COUNT=$(wc -l < "$FULL_PATH" 2>/dev/null || echo 0)
    CHAR_COUNT=$(wc -c < "$FULL_PATH" 2>/dev/null || echo 0)
    log ""
    log "   📄 $f"
    log "      行数: $LINE_COUNT | 字节数: $CHAR_COUNT"

    # awk 单次遍历获取 6 个计数
    COUNTS=$(run_bracket_check "$FULL_PATH")
    OPENS=$(echo "$COUNTS" | cut -d' ' -f1)
    CLOSES=$(echo "$COUNTS" | cut -d' ' -f2)
    B_OPENS=$(echo "$COUNTS" | cut -d' ' -f3)
    B_CLOSES=$(echo "$COUNTS" | cut -d' ' -f4)
    S_OPENS=$(echo "$COUNTS" | cut -d' ' -f5)
    S_CLOSES=$(echo "$COUNTS" | cut -d' ' -f6)

    # 括号 ()
    CHECKS_TOTAL=$((CHECKS_TOTAL + 1))
    if [ "$OPENS" -ne "$CLOSES" ]; then
        DIFF=$((OPENS - CLOSES))
        log "      ❌ [FAIL] 括号 () : ( $OPENS vs ) $CLOSES | 差值: $DIFF"
        log_only "      FAIL paren: $f (=$OPENS )=$CLOSES diff=$DIFF"
        ERRORS=$((ERRORS + 1)); CHECKS_FAIL=$((CHECKS_FAIL + 1))
    else
        log "      ✅ [PASS] 括号 () : ( $OPENS vs ) $CLOSES"
        log_only "      PASS paren: $f (=$OPENS )=$CLOSES"
        CHECKS_PASS=$((CHECKS_PASS + 1))
    fi

    # 花括号 {}
    CHECKS_TOTAL=$((CHECKS_TOTAL + 1))
    if [ "$B_OPENS" -ne "$B_CLOSES" ]; then
        DIFF=$((B_OPENS - B_CLOSES))
        log "      ❌ [FAIL] 花括号 {} : { $B_OPENS vs } $B_CLOSES | 差值: $DIFF"
        log_only "      FAIL brace: $f {=$B_OPENS }=$B_CLOSES diff=$DIFF"
        ERRORS=$((ERRORS + 1)); CHECKS_FAIL=$((CHECKS_FAIL + 1))
    else
        log "      ✅ [PASS] 花括号 {} : { $B_OPENS vs } $B_CLOSES"
        log_only "      PASS brace: $f {=$B_OPENS }=$B_CLOSES"
        CHECKS_PASS=$((CHECKS_PASS + 1))
    fi

    # 方括号 []
    CHECKS_TOTAL=$((CHECKS_TOTAL + 1))
    if [ "$S_OPENS" -ne "$S_CLOSES" ]; then
        DIFF=$((S_OPENS - S_CLOSES))
        log "      ❌ [FAIL] 方括号 [] : [ $S_OPENS vs ] $S_CLOSES | 差值: $DIFF"
        log_only "      FAIL bracket: $f [=$S_OPENS ]=$S_CLOSES diff=$DIFF"
        ERRORS=$((ERRORS + 1)); CHECKS_FAIL=$((CHECKS_FAIL + 1))
    else
        log "      ✅ [PASS] 方括号 [] : [ $S_OPENS vs ] $S_CLOSES"
        log_only "      PASS bracket: $f [=$S_OPENS ]=$S_CLOSES"
        CHECKS_PASS=$((CHECKS_PASS + 1))
    fi
done

log ""
log "📊 静态检查汇总: 总检查 $CHECKS_TOTAL | 通过 $CHECKS_PASS | 失败 $CHECKS_FAIL | 涉及文件 $FILE_COUNT"

if [ $ERRORS -gt 0 ]; then
    log "❌ 静态检查失败, 提交已阻止 ($ERRORS 个错误)"
    log "------------------------------------------------------------"
    log "📊 决策: BLOCK (静态检查失败) | 文件数: $FILE_COUNT | 检查数: $CHECKS_TOTAL | 通过: $CHECKS_PASS | 失败: $CHECKS_FAIL | 错误数: $ERRORS"
    log "============================================================"
    exit 1
fi

log "✅ 静态检查通过 (括号/花括号均匹配)"

# ---------- 3. 提示运行 CI 流水线 ----------
log ""
log "🚀 请在浏览器运行 CI 流水线确认:"
log "   http://localhost:8080/module-test.html → 🚀 CI流水线按钮"
log "   确认 185/185 PASS (100.0%)"

read -p "CI 流水线是否已通过 185/185? (Y/n) " response || true
log_only "   CI response: '$response'"

if [ "$response" = "n" ] || [ "$response" = "N" ]; then
    log "❌ CI 未通过 (用户输入: '$response'), 提交已阻止"
    log "------------------------------------------------------------"
    log "📊 决策: BLOCK (CI 未确认) | 文件数: $FILE_COUNT | 检查数: $CHECKS_TOTAL | 通过: $CHECKS_PASS | 失败: $CHECKS_FAIL | 响应: '$response'"
    log "============================================================"
    exit 1
fi

RESP_DESC="pass(非n)"
if [ -z "$response" ]; then
    RESP_DESC="EOF/empty(自动通过)"
fi

log "✅ CI 检查通过, 允许提交"
log "------------------------------------------------------------"
log "📊 决策: PASS | 文件数: $FILE_COUNT | 检查数: $CHECKS_TOTAL | 通过: $CHECKS_PASS | 失败: $CHECKS_FAIL | CI响应: $RESP_DESC"
log "============================================================"
exit 0
